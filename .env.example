# SafeStart demo: settings for working on your own laptop.
# Copy to .env (Windows PowerShell: copy .env.example .env), then run
# `php artisan key:generate`. Works with Herd and with `php artisan serve`.
#
# If the demo is ever shared outside your laptop, use the sharing values
# from the README ("Settings for sharing") and run `php artisan demo:preflight`.

APP_NAME=SafeStart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Herd: http://<folder-name>.test   artisan serve: http://127.0.0.1:8000
APP_URL=http://safestart-demo.test
# Where Herd serves this site; only used by demo:preflight.
HERD_URL=http://safestart-demo.test

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# No database: sessions, cache and queue all avoid one on purpose.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# false here because your laptop serves plain http://. Secure cookies are
# only sent over HTTPS, so with true every click would lose the session.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
