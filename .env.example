# SafeStart demo settings for SHARING a session through `herd share`.
# Copy to .env, then run `php artisan key:generate`.
# For local development you may set APP_ENV=local and APP_DEBUG=true,
# but always switch back to these values before you share a link.

APP_NAME=SafeStart
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://safestart-demo.test
# Where Herd serves this site; demo:preflight checks it for Herd Studio.
HERD_URL=http://safestart-demo.test

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# No database: sessions, cache and queue all avoid one on purpose.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
